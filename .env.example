# ─── Django ─────────────────────────────────────────────────────────
# В dev можно оставить пустым — settings.py подставит небезопасный
# fallback (годится только для локальной разработки).
# В prod ОБЯЗАТЕЛЬНО задать. Сгенерировать новый:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=

# True в dev, False в prod
DJANGO_DEBUG=True

# Список хостов через запятую, без пробелов и без схемы.
# dev:  127.0.0.1,localhost
# prod: leobuild.ru,www.leobuild.ru,<server-ip>
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# С схемой https://, через запятую. Нужно только на проде за HTTPS-прокси.
# prod: https://leobuild.ru,https://www.leobuild.ru
DJANGO_CSRF_TRUSTED_ORIGINS=


# ─── Roboflow (CV workflow) ─────────────────────────────────────────
# Получить в https://app.roboflow.com/settings/api
# Без этого ключа эндпоинт /api/proxy-roboflow/ вернёт ошибку.
ROBOFLOW_API_KEY=
ROBOFLOW_WORKSPACE=leobuild
ROBOFLOW_WORKFLOW_ID=detect-count-and-visualize-3
